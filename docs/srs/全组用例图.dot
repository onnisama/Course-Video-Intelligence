graph G {
graph [rankdir=LR,bgcolor="white",fontname="PingFang SC",label="全组用例图（待评审）\n同一系统分模块展示；同名角色表示同一参与者",labelloc=t,fontsize=24,compound=true];
node [fontname="PingFang SC",fontsize=16];
edge [color="#94a3b8"];
subgraph cluster_CRS { label="课程与权限 / 课程视频智能检索平台"; color="#cbd5e1";
aCRS0 [shape=box,style="rounded",label="«actor»\n教师（主要）"];
aCRS1 [shape=box,style="rounded",label="«actor»\n助教（主要/次要）"];
aCRS2 [shape=box,style="rounded",label="«actor»\n学生（主要/次要）"];
subgraph cluster_sys_CRS { label="系统边界"; color="#64748b";
"UC-CRS-01" [shape=ellipse,label="UC-CRS-01\n登录与退出"];
"UC-CRS-02" [shape=ellipse,label="UC-CRS-02\n创建课程"];
"UC-CRS-03" [shape=ellipse,label="UC-CRS-03\n编辑课程信息"];
"UC-CRS-04" [shape=ellipse,label="UC-CRS-04\n管理课程成员"];
"UC-CRS-05" [shape=ellipse,label="UC-CRS-05\n访问获授权课程"];
"UC-CRS-06" [shape=ellipse,label="UC-CRS-06\n确认外部处理授权"];
}
aCRS0 -- "UC-CRS-01";
aCRS1 -- "UC-CRS-01";
aCRS2 -- "UC-CRS-01";
aCRS0 -- "UC-CRS-02";
aCRS0 -- "UC-CRS-03";
aCRS0 -- "UC-CRS-04";
aCRS1 -- "UC-CRS-04";
aCRS2 -- "UC-CRS-04";
