aCRS2 -- "UC-CRS-05";
aCRS0 -- "UC-CRS-06";
}
subgraph cluster_SRC { label="学生检索与观看 / 课程视频智能检索平台"; color="#cbd5e1";
aSRC0 [shape=box,style="rounded",label="«actor»\n学生（主要）"];
subgraph cluster_sys_SRC { label="系统边界"; color="#64748b";
"UC-SRC-01" [shape=ellipse,label="UC-SRC-01\n学生在课程内搜索字幕"];
"UC-SRC-02" [shape=ellipse,label="UC-SRC-02\n学生查看搜索命中的字幕"];
"UC-SRC-03" [shape=ellipse,label="UC-SRC-03\n学生查看命中字幕的前后文"];
"UC-SRC-04" [shape=ellipse,label="UC-SRC-04\n学生从搜索结果跳转视频时间点"];
"UC-SRC-05" [shape=ellipse,label="UC-SRC-05\n学生通过章节目录浏览视频"];
}
